<Configuration status="warn">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %logger - %msg%n"/>
        </Console>

        <File name="InfoFile" fileName="D:/Users/Public/logs/info.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n"/>
            <Filters>
            <LevelMatchFilter level="info" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </File>
        
        <File name="DebugFile" fileName="D:/Users/Public/logs/debug.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n"/>  
            <Filters>
        <LevelMatchFilter level="debug" onMatch="ACCEPT" onMismatch="DENY"/>
    		</Filters>
        </File>

        <File name="WarnFile" fileName="D:/Users/Public/logs/warn.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n"/>
            <Filters>
            <LevelMatchFilter level="warn" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </File>

        <File name="ErrorFile" fileName="D:/Users/Public/logs/error.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n"/>
            <Filters>
            <LevelMatchFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </File>

    </Appenders>

    <Loggers>
        <Root level="debug">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="InfoFile" level="info"/>
            <AppenderRef ref="DebugFile" level="debug"/>
            <AppenderRef ref="WarnFile" level="warn"/>
            <AppenderRef ref="ErrorFile" level="error"/>
        </Root>
    </Loggers>

</Configuration>